{
  "name": "blaise-design-system-react-components",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ONSdigital/blaise-design-system-react-components.git"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "type": "module",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "yarn vite build && yarn publint --pack npm",
    "build-storybook": "storybook build -o storybook-static",
    "lint": "yarn typecheck && yarn eslint . && yarn prettier --check . && yarn knip",
    "lint-fix": "yarn eslint . --fix && yarn prettier --write . && yarn knip --fix",
    "prepack": "yarn build",
    "spellcheck": "yarn cspell \"**/*.{ts,tsx,json,jsonc,yml,yaml,md}\" --no-progress --no-summary",
    "storybook": "storybook dev -p 6006",
    "storybook-wsl": "CHOKIDAR_USEPOLLING=true storybook dev -p 6006",
    "test": "yarn vitest run --coverage",
    "test-watch": "yarn vitest",
    "typecheck": "yarn tsc --noEmit && yarn tsc --project tsconfig.build.json --noEmit"
  },
  "peerDependencies": {
    "formik": ">=2.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@types/react-csv": "^1.1.10",
    "react-csv": "^2.2.2"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.8.0",
    "@eslint/js": "^10.0.1",
    "@microsoft/api-extractor": "^7.58.7",
    "@storybook/addon-a11y": "^10.4.0",
    "@storybook/addon-docs": "^10.4.0",
    "@storybook/addon-links": "^10.4.0",
    "@storybook/react": "^10.4.0",
    "@storybook/react-vite": "^10.4.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.8.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.6",
    "cspell": "^10.0.0",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-jsonc": "^3.1.2",
    "eslint-plugin-storybook": "10.4.0",
    "formik": "^2.4.9",
    "globals": "^17.6.0",
    "jiti": "^2.7.0",
    "jsdom": "^29.1.1",
    "jsonc-eslint-parser": "^3.1.0",
    "knip": "^6.14.1",
    "prettier": "^3.8.3",
    "publint": "^0.3.21",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "storybook": "^10.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.3",
    "vite": "^8.0.13",
    "vite-plugin-dts": "^5.0.0",
    "vitest": "^4.1.6"
  },
  "packageManager": "yarn@4.14.1"
}
